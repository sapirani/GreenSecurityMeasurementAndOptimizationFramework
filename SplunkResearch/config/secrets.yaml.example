# Secrets configuration template
# Copy this file to secrets.yaml and fill in your actual credentials
# NEVER commit secrets.yaml to version control!

# Splunk credentials and host
splunk:
  host: "132.72.81.184"  # or 132.72.80.159 or 132.72.81.150
  username: "your_splunk_username"
  password: "your_splunk_password"

# Email credentials and settings (for notifications)
email:
  address: "your_email@example.com"
  password: "your_app_specific_password"
  # Optional: Override SMTP settings (defaults to Gmail)
  server: smtp.gmail.com
  port: 465
  use_ssl: true
  verify_ssl: true  # Keep true for security! Only set false for self-signed certs
  subject: "DRL Experiment Failed"

# Elasticsearch credentials
elasticsearch:
  password: "your_elasticsearch_password"
